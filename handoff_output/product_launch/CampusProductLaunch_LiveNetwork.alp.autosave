			<AdditionalClassCode><![CDATA[// Standalone Java kernel. The AnyLogic Main body embeds this as a static class.
// This class uses no AnyLogic APIs; engine integration is checked separately.
public static class ProductKernel {
    public static class Config {
        public int N=300,k0=8,groups=3,periods=60,nSamples=12;
        public double withinWeight=6,price=500,unitCost=250,d=.2,mu=.3,phi=.05,h=0,
            shareProb=.25,quality=.8,experienceSD=.1;
        public void check() {
            if(N<2||k0<0||k0>=N||groups!=3||periods<1||nSamples<0||nSamples>N||withinWeight<1||price<0||unitCost<0||
               !(d>0&&d<=1&&mu>=0&&mu<=.5&&phi>=0&&phi<=1&&h>=0&&h<=1&&shareProb>=0&&shareProb<=1&&quality>=0&&quality<=1&&experienceSD>=0))
                throw new IllegalArgumentException("Invalid launch configuration");
        }
    }
    public static class Customer {
        public int group,awarePeriod=-1,paidPeriod=-1;
        public double initialBelief,belief,valueScale,budget,experience,valueAtPurchase=-1;
        public boolean aware=false,freeSample=false;
    }
    public static final String[] STRATEGIES={"random","degree","distributed"};
    public static final String DAY_HEADER="period,aware,paid_buyers,free_samples,new_paid,revenue,total_cost,profit,paid_adoption,min_group_adoption,giant_frac,cross_group_frac,rewires,belief_mean,belief_variance,paid_group0,paid_group1,paid_group2,aware_group0,aware_group1,aware_group2,degree_zero,total_edges";
    public static final String SUMMARY_HEADER="cohort,scenario,rep,graph_seed,trait_seed,selection_seed,event_seed,strategy,N,k0,groups,within_weight,periods,n_samples,price,unit_cost,d,mu,phi,h,share_prob,quality,experience_sd,aware,paid_buyers,free_samples,new_paid,revenue,total_cost,profit,paid_adoption,min_group_adoption,giant_frac,cross_group_frac,rewires,belief_mean,belief_variance,paid_group0,paid_group1,paid_group2,aware_group0,aware_group1,aware_group2,degree_zero,total_edges,t20,hit20,restricted_t20,secs";
    public final Config config;
    public final int rep,strategy;
    public final Customer[] customers;
    public final boolean[][] adj;
    public final int[] degree;
    public final java.util.ArrayList<double[]> history=new java.util.ArrayList<>();
    public int period=0,rewires=0;
    public int activationInPeriod=0,lastI=-1,lastJ=-1,lastNew=-1;
    public double beforeI,beforeJ,afterI,afterJ;
    public String lastOutcome="Campaign initialized";
    public final java.util.Random eventRng;
    private final long started=System.nanoTime();

    public ProductKernel(Config c,int replication,int seedingStrategy) {
        c.check();if(replication<0||replication>=1000000||seedingStrategy<0||seedingStrategy>2)
            throw new IllegalArgumentException("Invalid replication or strategy");
        config=c;rep=replication;strategy=seedingStrategy;
        int n=c.N;customers=new Customer[n];adj=new boolean[n][n];degree=new int[n];
        java.util.Random graphRng=new java.util.Random(1000000L+rep);
        int edges=0,target=n*c.k0/2;
        while(edges<target) {
            int i=graphRng.nextInt(n),j=graphRng.nextInt(n);
            if(i==j||adj[i][j])continue;
            if(i%3!=j%3&&graphRng.nextDouble()>=1/c.withinWeight)continue;
            adj[i][j]=adj[j][i]=true;degree[i]++;degree[j]++;edges++;
        }
        java.util.Random traitRng=new java.util.Random(2000000L+rep);
        for(int i=0;i<n;i++) {
            Customer a=new Customer();a.group=i%3;
            double u=traitRng.nextDouble(),v=traitRng.nextDouble(),w=traitRng.nextDouble();
            a.initialBelief=Math.max(Math.min(u,v),Math.min(Math.max(u,v),w));
            a.belief=a.initialBelief;a.valueScale=500+500*traitRng.nextDouble();
            a.budget=400+600*traitRng.nextDouble();
            a.experience=Math.max(0,Math.min(1,c.quality+c.experienceSD*traitRng.nextGaussian()));
            customers[i]=a;
        }
        int[] priority=new int[n],rank=new int[n];for(int i=0;i<n;i++)priority[i]=i;
        java.util.Random selectionRng=new java.util.Random(3000000L+rep);
        for(int i=n-1;i>0;i--){int j=selectionRng.nextInt(i+1),tmp=priority[i];priority[i]=priority[j];priority[j]=tmp;}
        for(int i=0;i<n;i++)rank[priority[i]]=i;
        Integer[] order=new Integer[n];for(int i=0;i<n;i++)order[i]=i;
        java.util.Arrays.sort(order,(a,b)->degree[a]!=degree[b]?Integer.compare(degree[b],degree[a]):Integer.compare(rank[a],rank[b]));
        if(strategy==0)for(int t=0;t<c.nSamples;t++)sample(priority[t]);
        else if(strategy==1)for(int t=0;t<c.nSamples;t++)sample(order[t]);
        else {
            int picked=0,g=0;
            while(picked<c.nSamples) {
                for(int i:order)if(customers[i].group==g&&!customers[i].freeSample){sample(i);picked++;break;}
                g=(g+1)%3;
            }
        }
        eventRng=new java.util.Random(4000000L+rep);
        history.add(snapshot(0));
    }

    private void sample(int i){Customer a=customers[i];a.freeSample=true;a.aware=true;a.awarePeriod=0;a.belief=a.experience;}

    public void interaction(double[] u) {
        int n=config.N,i=(int)(u[0]*n);
        lastI=i;lastJ=-1;lastNew=-1;lastOutcome="No discussion contact";
        beforeI=afterI=customers[i].belief;
        if(degree[i]==0)return;
        int rank=(int)(u[1]*degree[i]),j=-1;
        for(int z=0;z<n;z++)if(adj[i][z]&&rank--==0){j=z;break;}
        if(j<0)throw new IllegalStateException("Neighbor rank mismatch");
        Customer a=customers[i],b=customers[j];
        lastJ=j;beforeJ=afterJ=b.belief;lastOutcome="Neither customer knows the launch";
        if(!a.aware&&!b.aware)return;
        boolean informed=false;
        if(a.aware!=b.aware) {
            lastOutcome="Launch news was not shared in this meeting";
            if(u[2]>=config.shareProb)return;
            Customer other=a.aware?b:a;other.aware=true;other.awarePeriod=period;
            informed=true;
        }
        double xi=a.belief,xj=b.belief;
        lastOutcome=informed?"Launch news shared; opinions too far apart":"Opinions too far apart; contact kept";
        if(Math.abs(xi-xj)<config.d){a.belief=xi+config.mu*(xj-xi);b.belief=xj+config.mu*(xi-xj);lastOutcome=informed?"News shared and opinions moved closer":"Opinions moved closer";}
        else if(u[3]<config.phi) {
            int[] candidates=new int[n];int count=0;
            if(u[4]<config.h)for(int k=0;k<n;k++)if(k!=i&&!adj[i][k]&&Math.abs(customers[k].belief-xi)<config.d)candidates[count++]=k;
            if(count==0)for(int k=0;k<n;k++)if(k!=i&&!adj[i][k])candidates[count++]=k;
            if(count>0) {
                int k=candidates[(int)(u[5]*count)];
                adj[i][j]=adj[j][i]=false;adj[i][k]=adj[k][i]=true;
                degree[j]--;degree[k]++;rewires++;
                lastNew=k;lastOutcome="Disagreement: discussion contact replaced";
            }
        }
        afterI=a.belief;afterJ=b.belief;
    }

    public boolean stepPeriod() {
        if(period>=config.periods&&activationInPeriod==0)return false;
        do{stepActivation();}while(activationInPeriod!=0);
        return period<config.periods;
    }

    public boolean stepActivation() {
        if(period>=config.periods&&activationInPeriod==0)return false;
        if(activationInPeriod==0)period++;
        double[] u=new double[6];for(int q=0;q<6;q++)u[q]=eventRng.nextDouble();
        interaction(u);activationInPeriod++;
        if(activationInPeriod<config.N)return true;
        activationInPeriod=0;
        int[] buyers=new int[config.N];int count=0;
        for(int i=0;i<config.N;i++) {
            Customer a=customers[i];double value=a.valueScale*a.belief;
            if(a.aware&&!a.freeSample&&a.paidPeriod<0&&a.budget>=config.price&&value>=config.price) {
                a.paidPeriod=period;a.valueAtPurchase=value;buyers[count++]=i;
            }
        }
        for(int z=0;z<count;z++)customers[buyers[z]].belief=customers[buyers[z]].experience;
        double[] row=snapshot(count);history.add(row);check(row);
        return period<config.periods;
    }

    public double[] snapshot(int newPaid) {
        int n=config.N,pa=0,aw=0,fr=0,edges=0,cross=0,isolates=0,giant=0;
        int[] pg=new int[3],ag=new int[3],eligible=new int[3];double mean=0,var=0;
        for(int i=0;i<n;i++) {
            Customer a=customers[i];boolean paid=a.paidPeriod>=0;
            pa+=paid?1:0;aw+=a.aware?1:0;fr+=a.freeSample?1:0;
            pg[a.group]+=paid?1:0;ag[a.group]+=a.aware?1:0;eligible[a.group]+=a.freeSample?0:1;
            mean+=a.belief;isolates+=degree[i]==0?1:0;
            for(int j=i+1;j<n;j++)if(adj[i][j]){edges++;cross+=a.group!=customers[j].group?1:0;}
        }
        mean/=n;for(Customer a:customers)var+=(a.belief-mean)*(a.belief-mean);var/=n;
        boolean[] seen=new boolean[n];int[] queue=new int[n];
        for(int root=0;root<n;root++)if(!seen[root]) {
            int front=0,end=0;queue[end++]=root;seen[root]=true;
            while(front<end){int u=queue[front++];for(int j=0;j<n;j++)if(adj[u][j]&&!seen[j]){seen[j]=true;queue[end++]=j;}}
            giant=Math.max(giant,end);
        }
        double minRate=1;boolean found=false;
        for(int g=0;g<3;g++)if(eligible[g]>0){found=true;minRate=Math.min(minRate,(double)pg[g]/eligible[g]);}
        return new double[]{period,aw,pa,fr,newPaid,config.price*pa,config.unitCost*(pa+fr),
            (config.price-config.unitCost)*pa-config.unitCost*fr,n>fr?(double)pa/(n-fr):0,
            found?minRate:0,(double)giant/n,edges>0?(double)cross/edges:0,rewires,mean,var,
            pg[0],pg[1],pg[2],ag[0],ag[1],ag[2],isolates,edges};
    }

    public void check(double[] row) {
        if(row[22]!=config.N*config.k0/2||row[3]!=config.nSamples||row[2]+row[3]>config.N||row[2]+row[3]>row[1])
            throw new IllegalStateException("Graph, sample or owner-count invariant failed");
        for(Customer a:customers) {
            if(!Double.isFinite(a.belief)||a.belief<0||a.belief>1)throw new IllegalStateException("Belief range failed");
            if(a.paidPeriod>=0&&(!a.aware||a.freeSample||a.budget<config.price||a.valueAtPurchase<config.price||a.awarePeriod>a.paidPeriod))
                throw new IllegalStateException("Purchase eligibility failed");
        }
    }

    public static String numbers(double[] row){java.util.ArrayList<String> a=new java.util.ArrayList<>();for(double v:row)a.add(Double.toString(v));return String.join(",",a);}
    public String summaryCsv(String cohort,String scenario) {
        Config c=config;java.util.ArrayList<String> a=new java.util.ArrayList<>();
        String[] meta={cohort,scenario,""+rep,""+(1000000L+rep),""+(2000000L+rep),""+(3000000L+rep),""+(4000000L+rep),STRATEGIES[strategy],
            ""+c.N,""+c.k0,""+c.groups,""+c.withinWeight,""+c.periods,""+c.nSamples,""+c.price,""+c.unitCost,""+c.d,""+c.mu,""+c.phi,""+c.h,""+c.shareProb,""+c.quality,""+c.experienceSD};
        java.util.Collections.addAll(a,meta);double[] last=history.get(history.size()-1);
        for(int i=1;i<last.length;i++)a.add(Double.toString(last[i]));
        int target=-1;double threshold=.2*(c.N-c.nSamples);
        for(double[] row:history)if(row[2]>=threshold){target=(int)row[0];break;}
        a.add(""+target);a.add(target>=0?"1":"0");a.add(""+(target>=0?target:c.periods));a.add(""+((System.nanoTime()-started)/1e9));
        return String.join(",",a);
    }
}


public ProductKernel launch;
public boolean launchExported=false,launchBatch=false;
public int launchCaseIndex=0,activePolicy=6,activeRep=1000,visualFrame=0,lastCurveRows=-1;
public int recentI=-1,recentJ=-1,rewireI=-1,rewireK=-1,rewireLife=0;
public double recentBeforeI,recentBeforeJ,recentAfterI,recentAfterJ;
public String recentOutcome="Campaign initialized";
public java.util.HashMap<Integer,com.anylogic.engine.presentation.ShapeLine> drawnTies=new java.util.HashMap<>();
public java.util.HashMap<Integer,Integer> tieStyles=new java.util.HashMap<>();
public int lastTieRewires=-1;
public java.util.ArrayList<String> networkHistory=new java.util.ArrayList<>();
public static final String NETWORK_HEADER="period,compatible_edges,discordant_edges,aware_nonowners,aware_cannot_afford,aware_low_value,ready_to_buy,belief_bin0,belief_bin1,belief_bin2,belief_bin3,belief_bin4,belief_bin5,belief_bin6,belief_bin7,belief_bin8,belief_bin9";

public void initializeLaunch(){
 if(policyIndex<0||policyIndex>36)throw new IllegalArgumentException("Choose policyIndex0..35 or36 for batch");
 launchBatch=policyIndex==36;launchCaseIndex=0;startLaunchCase(launchBatch?0:policyIndex,rep);
}
public void startLaunchCase(int policy,int replication){
 activePolicy=policy;activeRep=replication;int normal=policy%18;
 ProductKernel.Config c=new ProductKernel.Config();c.price=new double[]{400,500,600}[(normal/2)%3];c.h=normal%2;c.nSamples=policy>=18?3:12;
 launch=new ProductKernel(c,replication,normal/6);
 if(consumers.size()!=300)throw new IllegalStateException("Population must contain300 Consumer agents");
 for(int i=0;i<300;i++){
  Consumer a=consumers.get(i);a.customerId=i;a.state=launch.customers[i];int local=i/3;
  double angle=local*2.399963229728653,radius=165*Math.sqrt((local+.5)/100.0);
  a.setXY(220+425*(i%3)+radius*Math.cos(angle),405+radius*Math.sin(angle));
 }
 launchExported=false;visualFrame=0;recentI=recentJ=rewireI=rewireK=-1;rewireLife=0;lastTieRewires=-1;lastCurveRows=-1;
 drawnTies.clear();tieStyles.clear();linksLayer.clear();historyLayer.clear();histogramLayer.clear();networkHistory.clear();
 if(animateNetwork)refreshLaunchLinks();refreshLaunchDisplay();
}
public java.awt.Color beliefColor(double belief){
 double b=Math.max(0,Math.min(1,belief));return new java.awt.Color((int)(66+187*b),(int)(187-31*b),(int)(230-111*b));
}
public com.anylogic.engine.presentation.ShapeLine line(double x,double y,double dx,double dy,java.awt.Color color,double width,com.anylogic.engine.presentation.LineStyle style){
 return new com.anylogic.engine.presentation.ShapeLine(true,x,y,color,dx,dy,width,style);
}
public void refreshLaunchLinks(){
 for(Consumer a:consumers)a.disconnectFromAll();
 if(!animateNetwork)return;
 for(int i=0;i<300;i++)for(int j=i+1;j<300;j++)if(launch.adj[i][j])consumers.get(i).connectTo(consumers.get(j));
 synchronizeDisplayedTies();
}
public void synchronizeDisplayedTies(){
 if(!animateNetwork)return;
 if(launch.rewires!=lastTieRewires){
  java.util.Iterator<java.util.Map.Entry<Integer,com.anylogic.engine.presentation.ShapeLine>> it=drawnTies.entrySet().iterator();
  while(it.hasNext()){
   java.util.Map.Entry<Integer,com.anylogic.engine.presentation.ShapeLine> e=it.next();int i=e.getKey()/300,j=e.getKey()%300;
   if(!launch.adj[i][j]){linksLayer.remove(e.getValue());tieStyles.remove(e.getKey());it.remove();}
  }
  for(int i=0;i<300;i++)for(int j=i+1;j<300;j++)if(launch.adj[i][j]){
   int key=i*300+j;if(!drawnTies.containsKey(key)){
    Consumer a=consumers.get(i),z=consumers.get(j);
    com.anylogic.engine.presentation.ShapeLine edge=line(a.getX(),a.getY(),z.getX()-a.getX(),z.getY()-a.getY(),new java.awt.Color(132,151,179,30),.6,com.anylogic.engine.presentation.LineStyle.LINE_STYLE_DOTTED);
    linksLayer.add(edge);drawnTies.put(key,edge);
   }
  }
  lastTieRewires=launch.rewires;
 }
 if(visualFrame%4==0||visualFrame==0)for(java.util.Map.Entry<Integer,com.anylogic.engine.presentation.ShapeLine> e:drawnTies.entrySet()){
  int i=e.getKey()/300,j=e.getKey()%300;ProductKernel.Customer a=launch.customers[i],z=launch.customers[j];
  boolean compatible=Math.abs(a.belief-z.belief)<launch.config.d;
  int code=compatible?(a.aware&&z.aware?2:1):0;
  if(tieStyles.getOrDefault(e.getKey(),-1)!=code){
   e.getValue().setLineStyle(compatible?com.anylogic.engine.presentation.LineStyle.LINE_STYLE_SOLID:com.anylogic.engine.presentation.LineStyle.LINE_STYLE_DOTTED);
   e.getValue().setColor(code==2?new java.awt.Color(61,132,177,80):code==1?new java.awt.Color(61,132,177,50):new java.awt.Color(125,132,143,48));tieStyles.put(e.getKey(),code);
  }
 }
}
public void positionHighlight(com.anylogic.engine.presentation.ShapeRectangle shape,int i,int j){
 Consumer a=consumers.get(i),z=consumers.get(j);double dx=z.getX()-a.getX(),dy=z.getY()-a.getY();
 shape.setPos(a.getX(),a.getY());shape.setWidth(Math.sqrt(dx*dx+dy*dy));shape.setRotation(Math.atan2(dy,dx));
}
public double[] networkMetrics(){
 int compatible=0,nonowners=0,budget=0,value=0,ready=0;int[] hist=new int[10];
 for(int i=0;i<300;i++){
  ProductKernel.Customer a=launch.customers[i];hist[Math.min(9,(int)(10*a.belief))]++;
  if(a.aware&&!a.freeSample&&a.paidPeriod<0){nonowners++;if(a.budget<launch.config.price)budget++;else if(a.valueScale*a.belief<launch.config.price)value++;else ready++;}
  for(int j=i+1;j<300;j++)if(launch.adj[i][j]&&Math.abs(a.belief-launch.customers[j].belief)<launch.config.d)compatible++;
 }
 if(budget+value+ready!=nonowners)throw new IllegalStateException("Decision-reason partition failed");
 double[] out=new double[17];out[0]=launch.period;out[1]=compatible;out[2]=1200-compatible;out[3]=nonowners;out[4]=budget;out[5]=value;out[6]=ready;
 int total=0;for(int j=0;j<10;j++){out[7+j]=hist[j];total+=hist[j];}if(total!=300)throw new IllegalStateException("Opinion histogram failed");return out;
}
public void refreshHistory(double[] metrics){
 if(launch.history.size()==lastCurveRows)return;
 lastCurveRows=launch.history.size();networkHistory.add(ProductKernel.numbers(metrics));
 if(!animateNetwork)return;
 historyLayer.clear();
 for(int k=1;k<launch.history.size();k++){
  double[] a=launch.history.get(k-1),z=launch.history.get(k);double x1=65+325*a[0]/60.0,x2=65+325*z[0]/60.0;
  historyLayer.add(line(x1,825-90*a[1]/300,x2-x1,-90*(z[1]-a[1])/300,new java.awt.Color(240,183,82),2.1,com.anylogic.engine.presentation.LineStyle.LINE_STYLE_SOLID));
  historyLayer.add(line(x1,825-90*a[2]/300,x2-x1,-90*(z[2]-a[2])/300,new java.awt.Color(86,214,160),2.3,com.anylogic.engine.presentation.LineStyle.LINE_STYLE_SOLID));
 }
}
public void refreshLaunchDisplay(){
 if(launch==null)return;
 double[] r=launch.snapshot(0),m=networkMetrics();refreshHistory(m);
 if(!animateNetwork)return;
 for(Consumer a:consumers){a.nodeMark.setFillColor(a.stateColor());a.ownerMark.setFillColor(a.ownerColor());a.focusMark.setVisible(a.customerId==recentI||a.customerId==recentJ||a.customerId==rewireK&&rewireLife>0);}
 synchronizeDisplayedTies();
 statusLabel.setText("Period "+launch.period+" / 60   |   price Rs "+(int)launch.config.price+"   |   "+launch.config.nSamples+" samples   |   "+new String[]{"Random recipients","Most contacts","Across social groups"}[launch.strategy]+"   |   contacts: "+(launch.config.h==0?"random":"similar"));
 kpiLabel.setText("Aware "+(int)r[1]+" / 300        Paid buyers "+(int)r[2]+"        Free samples "+(int)r[3]+"        Profit Rs "+(int)r[7]);
 financeLabel.setText("Revenue Rs "+(int)r[5]+"  -  all bottle costs Rs "+(int)r[6]+"  =  modeled profit");
 reachLabel.setText("Aware "+(int)r[1]+"     Paid "+(int)r[2]+"     |     periods 0–60");
 statsLabel.setText(String.format(java.util.Locale.US,"Compatible ties  %.1f%%   |   Replaced  %d\nLargest component  %.1f%%\nMean belief  %.3f   |   SD  %.3f",100*m[1]/1200,launch.rewires,100*r[10],r[13],Math.sqrt(r[14])));
 reasonsLabel.setText("Aware, not buying: "+(int)m[3]+"\nBudget too low: "+(int)m[4]+"   |   value too low: "+(int)m[5]+"\nReady at the next period end: "+(int)m[6]);
 histogramLayer.clear();double max=1;for(int j=0;j<10;j++)max=Math.max(max,m[7+j]);
 for(int j=0;j<10;j++)histogramLayer.add(new com.anylogic.engine.presentation.ShapeRectangle(true,480+28*j,825-90*m[7+j]/max,0,null,beliefColor((j+.5)/10.0),20,90*m[7+j]/max,0,com.anylogic.engine.presentation.LineStyle.LINE_STYLE_SOLID));
 histMaxLabel.setText((int)max+" people at top of scale");
 meetingLine.setVisible(recentI>=0&&recentJ>=0);
 if(recentI>=0&&recentJ>=0){
  positionHighlight(meetingLine,recentI,recentJ);
  interactionLabel.setText("Meeting "+recentI+" and "+recentJ+"   |   "+recentOutcome);
  beliefLabel.setText(String.format(java.util.Locale.US,"Their opinions:  %.3f -> %.3f      and      %.3f -> %.3f",recentBeforeI,recentAfterI,recentBeforeJ,recentAfterJ));
 }else{interactionLabel.setText("Sample recipients begin the launch. Watch awareness travel through contacts.");beliefLabel.setText("Customers are colored by awareness and ownership. Opinions appear here and in the distribution plot.");}
 newContactLine.setVisible(rewireLife>0&&rewireI>=0&&rewireK>=0);if(rewireLife>0)positionHighlight(newContactLine,rewireI,rewireK);
}
public void advanceLaunchPeriod(){
 if(launchExported)return;
 if(animateNetwork){
  for(int tick=0;tick<10;tick++){
   launch.stepActivation();
   if(launch.lastNew>=0){rewireI=launch.lastI;rewireK=launch.lastNew;rewireLife=18;}
   if(launch.activationInPeriod==0)break;
  }
 }else launch.stepPeriod();
 visualFrame++;if(rewireLife>0)rewireLife--;
 if(visualFrame%4==1||recentI<0){recentI=launch.lastI;recentJ=launch.lastJ;recentBeforeI=launch.beforeI;recentBeforeJ=launch.beforeJ;recentAfterI=launch.afterI;recentAfterJ=launch.afterJ;recentOutcome=launch.lastOutcome;}
 if(animateNetwork&&launch.activationInPeriod==0)refreshLaunchLinks();refreshLaunchDisplay();
 if(launch.period>=60&&launch.activationInPeriod==0){exportLaunch();if(launchBatch&&++launchCaseIndex<180)startLaunchCase(launchCaseIndex/5,rep+launchCaseIndex%5);else finishSimulation();}
}
public void exportLaunch(){
 if(launchExported)return;
 String id="policy"+activePolicy+"_rep"+activeRep,scenario=launch.config.nSamples==12?"baseline":"budget3";java.nio.file.Path base=java.nio.file.Paths.get(outputDirectory);
 try{
  java.nio.file.Files.createDirectories(base.resolve("summary"));java.nio.file.Files.createDirectories(base.resolve("trajectories"));java.nio.file.Files.createDirectories(base.resolve("network_metrics"));
  java.nio.file.Files.write(base.resolve("summary").resolve(id+".csv"),java.util.Arrays.asList(ProductKernel.SUMMARY_HEADER,launch.summaryCsv("anylogic",scenario)),java.nio.charset.StandardCharsets.UTF_8);
  java.util.ArrayList<String> rows=new java.util.ArrayList<>();rows.add("cohort,scenario,rep,strategy,price,h,"+ProductKernel.DAY_HEADER);
  for(double[] r:launch.history)rows.add("anylogic,"+scenario+","+activeRep+","+ProductKernel.STRATEGIES[launch.strategy]+","+launch.config.price+","+launch.config.h+","+ProductKernel.numbers(r));
  java.nio.file.Files.write(base.resolve("trajectories").resolve(id+".csv"),rows,java.nio.charset.StandardCharsets.UTF_8);
  java.util.ArrayList<String> net=new java.util.ArrayList<>();net.add(NETWORK_HEADER);net.addAll(networkHistory);java.nio.file.Files.write(base.resolve("network_metrics").resolve(id+".csv"),net,java.nio.charset.StandardCharsets.UTF_8);
  launchExported=true;traceln("Launch CSV saved: "+base.resolve("summary").resolve(id+".csv").toAbsolutePath());
 }catch(java.io.IOException e){throw new RuntimeException("CSV export failed",e);}
}
